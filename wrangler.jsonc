{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kathys-cart-north-vancouver",
  "main": "index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "FLYER_VAULT",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
